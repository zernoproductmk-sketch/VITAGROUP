POSTGRES_DB=vitagroup
POSTGRES_USER=vitagroup
POSTGRES_PASSWORD=change-this-before-deploy
ENVIRONMENT=production
CORS_ORIGINS=https://corpvitagroup.ru
BUSINESS_TIMEZONE=Europe/Moscow

# Authentication — generate a long random value on the production server.
AUTH_JWT_SECRET=replace-with-at-least-64-random-characters
AUTH_ACCESS_TOKEN_MINUTES=480
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

# Coverse — real token is stored only on the production server.
COVERSE_API_TOKEN=
COVERSE_API_BASE_URL=https://api.coverse.team
COVERSE_READ_RANGE_PATH=/v1/documents/{document_id}/values

# Yandex Disk production plan.
# Do not commit the real public share URL to GitHub.
YANDEX_PLAN_PUBLIC_URL=
# Optional: path to a file if YANDEX_PLAN_PUBLIC_URL points to a shared folder.
YANDEX_PLAN_RESOURCE_PATH=

# ERP plan fallback when source file has no explicit shift.
# SOURCE_DATE keeps the source date; NEXT_DAY treats it as assignment issue date
# and schedules the configured shift on the following calendar day.
ERP_PLAN_MISSING_SHIFT_POLICY=SOURCE_DATE
ERP_PLAN_DEFAULT_SHIFT_CODE=DAY

# PostgreSQL backups stored in the Docker backup volume.
BACKUP_RETENTION_DAYS=14
