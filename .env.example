POSTGRES_DB=vitagroup
POSTGRES_USER=vitagroup
POSTGRES_PASSWORD=change-this-before-deploy
ENVIRONMENT=production
CORS_ORIGINS=https://corpvitagroup.ru
BUSINESS_TIMEZONE=Europe/Moscow

# Coverse — real token is stored only on the production server.
COVERSE_API_TOKEN=
COVERSE_API_BASE_URL=https://api.coverse.team
COVERSE_READ_RANGE_PATH=/v1/documents/{document_id}/values

# Yandex Disk production plan.
# Do not commit the real public share URL to GitHub.
YANDEX_PLAN_PUBLIC_URL=
# Optional: path to a file if YANDEX_PLAN_PUBLIC_URL points to a shared folder.
YANDEX_PLAN_RESOURCE_PATH=
